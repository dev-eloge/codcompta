# CODCompta — production settings for docker compose.
# On the server: cp deploy/production.env.example .env, then fill in the values marked "à remplir".

APP_NAME=CODCompta
APP_ENV=production
# à remplir : echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://elogecompta.africodehub.net
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Port where the containers listen, on the server only (the HTTPS proxy points to it).
APP_PORT=8081

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL runs in its own container: DB_HOST is set by docker-compose.yml.
DB_DATABASE=codcompta
DB_USERNAME=codcompta
# à remplir : deux mots de passe longs et différents (ex. openssl rand -base64 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
# A reading can take up to 3 minutes: do not hand the same job to a second worker before that.
DB_QUEUE_RETRY_AFTER=300
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Emails « Mot de passe oublié » : à remplir, sinon aucun email ne part (voir DEPLOIEMENT.md, étape 5).
# Exemple avec Brevo (gratuit jusqu'à 300 emails par jour) : smtp-relay.brevo.com, port 587.
MAIL_MAILER=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@africodehub.net
MAIL_FROM_NAME=CODCompta

# à remplir : clé de l'API Claude (console.anthropic.com), pour lire les messages des agences
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# à remplir : « Continuer avec Google » (console.cloud.google.com > Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://elogecompta.africodehub.net/google/callback

# à remplir : notifications de Sika (objectif noté, atteint, manqué).
# Crée les clés une seule fois avec : docker compose exec app php artisan codcompta:vapid
# puis ne les change plus (sinon chaque utilisateur doit réactiver les notifications).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@africodehub.net

# Vidéo de démonstration sur la page d'accueil (lien YouTube, Vimeo ou .mp4), facultatif
DEMO_VIDEO_URL=

# Pages légales (mentions légales, confidentialité, conditions). Laissez vide ce qui ne s'applique pas.
LEGAL_PUBLISHER="CODCompta"
LEGAL_RESPONSIBLE=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_HOST=
LEGAL_HOST_ADDRESS=
LEGAL_JURISDICTION="Lomé (Togo)"
